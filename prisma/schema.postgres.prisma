// 云端部署用（PostgreSQL，如 Neon / Supabase 免费版）
// 用法（Vercel 构建时自动执行，见 vercel.json）：
//   prisma generate --schema prisma/schema.postgres.prisma
//   prisma db push   --schema prisma/schema.postgres.prisma
// 本地开发继续使用 schema.prisma（SQLite），两份 schema 的模型完全一致。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 题库题目
// type: single 单选题 | judge 判断题 | blank 填空题 | short 简答题
// options: JSON 字符串，单选题为 [{ key: "A", text: "..." }]，其他题型为 []
model Question {
  id          String   @id @default(cuid())
  type        String
  stem        String
  options     String   @default("[]")
  answer      String   @default("")
  explanation String   @default("")
  source      String   @default("")
  starred     Boolean  @default(false)
  wrong       Boolean  @default(false)
  rightCount  Int      @default(0)
  wrongCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([wrong])
  @@index([starred])
}
